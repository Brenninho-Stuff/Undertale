import lime.tools.HXProject;
import lime.tools.Asset;
import lime.tools.Icon;
import hxp.Haxelib;

class Project extends HXProject {

	// ─── Build Constants ───────────────────────────────────────────────────────
	static inline final GAME_TITLE   : String = "Undertale Fan Engine";
	static inline final PACKAGE_NAME : String = "com.brenninho.undertale";
	static inline final VERSION      : String = "1.0.0";
	static inline final COMPANY      : String = "Brenninho-Stuff";
	static inline final BUILD_NUM    : String = "1";

	static inline final CANVAS_W     : Int    = 640;
	static inline final CANVAS_H     : Int    = 480;
	static inline final TARGET_FPS   : Int    = 60;

	// ─── Constructor ──────────────────────────────────────────────────────────
	public function new() {

		super();

		setupMeta();
		setupSources();
		setupAssets();
		setupDependencies();
		setupCompilerFlags();
		setupWindowAndOutput();
		setupIcons();

	}

	// ─── Meta ─────────────────────────────────────────────────────────────────
	function setupMeta():Void {
		meta.title       = GAME_TITLE;
		meta.packageName = PACKAGE_NAME;
		meta.version     = VERSION;
		meta.company     = COMPANY;
		meta.buildNumber = BUILD_NUM;
	}

	// ─── Sources ──────────────────────────────────────────────────────────────
	function setupSources():Void {
		sources.push("source");
	}

	// ─── Assets ───────────────────────────────────────────────────────────────
	// Lime's Asset object accepts `path`, `rename`, and `include` as fields.
	// Setting include to "*" tells Lime to recurse every subfolder and infer
	// each file's AssetType automatically from its extension.
	function setupAssets():Void {
		var a     = new Asset();
		a.path    = "assets";
		a.rename  = "assets";
		a.include = "*";
		assets.push(a);
	}

	// ─── Dependencies ─────────────────────────────────────────────────────────
	function setupDependencies():Void {
		haxelibs.push(new Haxelib("flixel",         ""));
		haxelibs.push(new Haxelib("flixel-addons",  ""));
		haxelibs.push(new Haxelib("flixel-ui",      ""));
		haxelibs.push(new Haxelib("openfl",          ""));
		haxelibs.push(new Haxelib("lime",            ""));
		haxelibs.push(new Haxelib("hscript",         ""));
		haxelibs.push(new Haxelib("actuate",         ""));
	}

	// ─── Compiler Flags ───────────────────────────────────────────────────────
	// haxedefs is Map<String, Dynamic> — use bracket notation
	function setupCompilerFlags():Void {

		haxedefs["HSCRIPT_ALLOWED"]          = 1;
		haxedefs["MOD_SUPPORT"]              = 1;
		haxedefs["SAVE_STATES"]              = 1;

		haxedefs["FLX_NO_TOUCH"]             = 1;
		haxedefs["FLX_NO_SOUND_TRAY"]        = 1;
		haxedefs["FLX_NO_FOCUS_LOST_SCREEN"] = 1;

		#if debug
		haxedefs["FLX_DEBUG"]  = 1;
		haxedefs["FLX_RECORD"] = 1;
		#else
		haxedefs["FLX_NO_DEBUG"] = 1;
		#end

	}

	// ─── Window & Output ──────────────────────────────────────────────────────
	function setupWindowAndOutput():Void {

		window.width      = CANVAS_W;
		window.height     = CANVAS_H;
		window.fps        = TARGET_FPS;
		window.background = 0x000000;
		window.hardware   = true;
		window.vsync      = false;
		window.resizable  = true;
		window.fullscreen = false;

		switch (target) {

			case HTML5:
				app.path = "export/html5";
				app.file = "index";

				haxedefs["openfl_html5_use_webgl"]      = 1;
				haxedefs["lime_html5_use_typed_arrays"]  = 1;
				haxedefs["openfl_preload_all"]           = 1;

			case WINDOWS:
				app.path = "export/windows";

			case LINUX:
				app.path = "export/linux";

			case MAC:
				app.path = "export/mac";

			default:
				app.path = "export/other";

		}

	}

	// ─── Icons ────────────────────────────────────────────────────────────────
	function setupIcons():Void {
		var icon  = new Icon();
		icon.path = "assets/arts/icon.png";
		icons.push(icon);
	}

}